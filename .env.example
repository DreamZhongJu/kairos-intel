# Copy this file to .env and fill in your own values. Never commit .env.
LARK_APP_ID=
LARK_APP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Model provider (defaults to DeepSeek for backward compatibility)
# MODEL_PROVIDER=deepseek        # deepseek | openai | qwen | moonshot | zhipu | siliconflow | openrouter | ollama
# MODEL_BASE_URL=
# MODEL_API_KEY=
# MODEL_NAME=

# Example: OpenRouter brain behind a local proxy (Feishu traffic stays direct)
# MODEL_PROVIDER=openrouter
# MODEL_NAME=stealth/ox-alpha
# OPENROUTER_API_KEY=sk-or-v1-xxx
# MODEL_PROXY=http://127.0.0.1:7890        # in docker: http://host.docker.internal:7890

# Shared token for machine-to-machine knowledge endpoints (empty = allow all)
# KAIROS_API_TOKEN=

# SDK-level retries for LLM calls (connection errors/timeouts/429/5xx), for
# flaky proxies. Default 3.
# MODEL_MAX_RETRIES=3

# Model failover chain: when the primary provider fails, try these in order.
# PROXY accepts a URL, "direct" (bypass env proxies) or unset (inherit MODEL_PROXY).
# MODEL_FALLBACK_1_PROVIDER=zen
# MODEL_FALLBACK_1_BASE_URL=https://opencode.ai/zen/v1
# MODEL_FALLBACK_1_API_KEY=sk-xxx
# MODEL_FALLBACK_1_MODEL=x-preview-f-free
# MODEL_FALLBACK_1_PROXY=direct
# MODEL_FAILOVER_COOLDOWN=300

# Knowledge-graph extraction: optional dedicated (faster/cheaper) model and
# parallel chunk workers. Unset falls back to the global model / 3 workers.
# ROUTER_EXTRACT_PROVIDER=deepseek
# ROUTER_EXTRACT_MODEL=deepseek-v4-flash
# EXTRACT_WORKERS=3

# Optional local services
CLAUDE_MEM_URL=http://host.docker.internal:37777
DAILY_REPORT_DIR=/reports
SKILLS_DIR=/app/skills

# Daily report delivery.  When FEISHU_REPORT_CHAT_ID is set, the report is
# pushed through the assistant's own Feishu bot (the brain channel, tenant
# token); otherwise it falls back to the custom-bot webhook FEISHU_WEBHOOK_URL.
# FEISHU_REPORT_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
