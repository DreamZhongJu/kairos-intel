# Copy this file to .env and fill in your own values. Never commit .env.
LARK_APP_ID=
LARK_APP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Model provider (defaults to DeepSeek for backward compatibility)
# MODEL_PROVIDER=deepseek        # deepseek | openai | qwen | moonshot | zhipu | siliconflow | openrouter | ollama
# MODEL_BASE_URL=
# MODEL_API_KEY=
# MODEL_NAME=

# Optional local services
CLAUDE_MEM_URL=http://host.docker.internal:37777
DAILY_REPORT_DIR=/reports
SKILLS_DIR=/app/skills
