[Unit]
Description=Kairós local Claude-Mem worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/kairos/claude-mem/source
EnvironmentFile=/srv/kairos/claude-mem/.env
Environment=HOME=/srv/kairos/claude-mem/data
Environment=CLAUDE_MEM_DATA_DIR=/srv/kairos/claude-mem/data/.claude-mem
Environment=CLAUDE_MEM_WORKER_HOST=172.17.0.1
Environment=CLAUDE_MEM_WORKER_PORT=37777
Environment=CLAUDE_MEM_PROVIDER=openrouter
Environment=CLAUDE_MEM_OPENROUTER_BASE_URL=https://api.deepseek.com
Environment=CLAUDE_MEM_OPENROUTER_MODEL=deepseek-chat
Environment=CLAUDE_MEM_CHROMA_ENABLED=false
Environment=CLAUDE_MEM_CLOUD_SYNC_TOKEN=
Environment=CLAUDE_MEM_CLOUD_SYNC_USER_ID=
Environment=NO_PROXY=localhost,127.0.0.1,api.deepseek.com
ExecStart=/srv/kairos/claude-mem/bun/bin/bun /srv/kairos/claude-mem/source/plugin/scripts/worker-service.cjs --daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
